use Std.Collections.Vector as V
use Std.Collections.HashMap as H
use Std.St as St
use Diff.Types

-- --- common runs ----------------------------------------------------------------------

-- How many elements match from the starts of `oa..ob` and `na..nb`.
@pub(pkg) fun commonPrefixLen same oa ob na nb =
  if oa >= ob or na >= nb
  then 0
  else
    let n = if ob - oa < nb - na then ob - oa else nb - na in
    let rec go k = if k < n and same (oa + k) (na + k) then go (k + 1) else k in
    go 0

-- How many elements match from the ends of `oa..ob` and `na..nb`.
@pub(pkg) fun commonSuffixLen same oa ob na nb =
  if oa >= ob or na >= nb
  then 0
  else
    let n = if ob - oa < nb - na then ob - oa else nb - na in
    let rec go k = if k < n and same (ob - 1 - k) (nb - 1 - k) then go (k + 1) else k in
    go 0

-- --- Myers ----------------------------------------------------------------------------

fun maxD len1 len2 = (len1 + len2 + 1) / 2 + 1

-- The crate's `myers::diff`: the operations for `oa..ob` against `na..nb`.
@pub(pkg) fun myers same oa ob na nb =
  runSt (\() ->
    let top = maxD (ob - oa) (nb - na) in
    let vf = St.newArray (2 * top) 0 in
    let vb = St.newArray (2 * top) 0 in
    let out = St.newRef V.empty in
    let emit = \op -> St.modifyRef out (\ops -> V.pushBack ops op) in
    let getV = \v k -> St.get v (k + top) in
    let setV = \v k x -> St.set v (k + top) x in
    -- The crate's `find_middle_snake`: `(x, y)` to split at, or `(0 - 1, 0)`.
    let snake = \a1 a2 b1 b2 ->
      let n = a2 - a1 in
      let m = b2 - b1 in
      let delta = n - m in
      let odd = delta % 2 != 0 in
      let _ = setV vf 1 0 in
      let _ = setV vb 1 0 in
      let dMax = maxD n m in
      let rec forward d k =
        if k < 0 - d
        then None
        else
          let x0 =
            if k == 0 - d or (k != d and getV vf (k - 1) < getV vf (k + 1))
            then getV vf (k + 1)
            else getV vf (k - 1) + 1
          in
          let y0 = x0 - k in
          let x =
            if x0 < n and y0 >= 0 and y0 < m
            then x0 + commonPrefixLen same (a1 + x0) a2 (b1 + y0) b2
            else x0
          in
          let _ = setV vf k x in
          let back = k - delta in
          if odd and abs back <= d - 1 and x + getV vb (0 - back) >= n
          then Just (x0 + a1, y0 + b1)
          else forward d (k - 2)
      in
      let rec backward d k =
        if k < 0 - d
        then None
        else
          let x0 =
            if k == 0 - d or (k != d and getV vb (k - 1) < getV vb (k + 1))
            then getV vb (k + 1)
            else getV vb (k - 1) + 1
          in
          let y0 = x0 - k in
          let advance =
            if x0 < n and y0 >= 0 and y0 < m
            then commonSuffixLen same a1 (a1 + n - x0) b1 (b1 + m - y0)
            else 0
          in
          let x = x0 + advance in
          let y = y0 + advance in
          let _ = setV vb k x in
          let back = k - delta in
          if not odd and abs back <= d and x + getV vf (0 - back) >= n
          then Just (n - x + a1, m - y + b1)
          else backward d (k - 2)
      in
      let rec rounds d =
        if d >= dMax
        then None
        else
          match forward d d with
          | Just found -> Just found
          | None ->
              match backward d d with
              | Just found -> Just found
              | None -> rounds (d + 1)
      in
      rounds 0
    in
    let rec conquer a1 a2 b1 b2 =
      let prefix = commonPrefixLen same a1 a2 b1 b2 in
      let _ = if prefix > 0 then emit (DiffOp.Equal a1 b1 prefix) else () in
      let c1 = a1 + prefix in
      let d1 = b1 + prefix in
      let suffix = commonSuffixLen same c1 a2 d1 b2 in
      let c2 = a2 - suffix in
      let d2 = b2 - suffix in
      let _ =
        if c1 >= c2 and d1 >= d2
        then ()
        else if d1 >= d2
        then emit (DiffOp.Delete c1 (c2 - c1) d1)
        else if c1 >= c2
        then emit (DiffOp.Insert c1 d1 (d2 - d1))
        else
          match snake c1 c2 d1 d2 with
          | Just (x, y) ->
              let _ = conquer c1 x d1 y in
              conquer x c2 y d2
          | None ->
              let _ = emit (DiffOp.Delete c1 (c2 - c1) d1) in
              emit (DiffOp.Insert c1 d1 (d2 - d1))
      in
      if suffix > 0 then emit (DiffOp.Equal c2 d2 suffix) else ()
    in
    let _ = conquer oa ob na nb in
    St.getRef out)

-- --- LCS ------------------------------------------------------------------------------

-- The crate's `lcs::diff`, quirks and all: its table is built over the
-- sequences from index 0, and read as if it were built from the common
-- prefix on, which only agree when both start at 0 with no common prefix.
@pub(pkg) fun lcs same oa ob na nb =
  if nb <= na
  then [DiffOp.Delete oa (ob - oa) na]
  else if ob <= oa
  then [DiffOp.Insert oa na (nb - na)]
  else
    let prefix = commonPrefixLen same oa ob na nb in
    let suffix = commonSuffixLen same (oa + prefix) ob (na + prefix) nb in
    if prefix == ob - oa and ob - oa == nb - na
    then [DiffOp.Equal 0 0 (ob - oa)]
    else
      let newLen = nb - na - prefix - suffix in
      let oldLen = ob - oa - prefix - suffix in
      runSt (\() ->
        let width = oldLen + 1 in
        let table = St.newArray ((newLen + 1) * width) 0 in
        let at = \i j -> if i > newLen or j > oldLen then 0 else St.get table (i * width + j) in
        let _ =
          St.forRange 0 newLen (\ri ->
            let i = newLen - 1 - ri in
            St.forRange 0 oldLen (\rj ->
              let j = oldLen - 1 - rj in
              let v =
                if same j i
                then at (i + 1) (j + 1) + 1
                else (let a = at (i + 1) j in let b = at i (j + 1) in if a > b then a else b)
              in
              St.set table (i * width + j) v))
        in
        let start = if prefix > 0 then [DiffOp.Equal oa na prefix] else V.empty in
        let rec walk oi ni out =
          if ni < newLen and oi < oldLen
          then
            let oo = oa + prefix + oi in
            let no = na + prefix + ni in
            if same oo no
            then walk (oi + 1) (ni + 1) (V.pushBack out (DiffOp.Equal oo no 1))
            else if at ni (oi + 1) >= at (ni + 1) oi
            then walk (oi + 1) ni (V.pushBack out (DiffOp.Delete oo 1 no))
            else walk oi (ni + 1) (V.pushBack out (DiffOp.Insert oo no 1))
          else (oi, ni, out)
        in
        match walk 0 0 start with
        | (oi, ni, out) ->
            let deleted =
              if oi < oldLen
              then V.pushBack out (DiffOp.Delete (oa + prefix + oi) (oldLen - oi) (na + prefix + ni))
              else out
            in
            let oi2 = if oi < oldLen then oldLen else oi in
            let inserted =
              if ni < newLen
              then V.pushBack deleted (DiffOp.Insert (oa + prefix + oi2) (na + prefix + ni) (newLen - ni))
              else deleted
            in
            if suffix > 0
            then V.pushBack inserted (DiffOp.Equal (oa + oldLen + prefix) (na + newLen + prefix) suffix)
            else inserted)

-- --- patience ---------------------------------------------------------------------------

-- The indices from `from` to `to` whose key occurs there exactly once, in
-- order: the crate's `unique`.
@pub(pkg) fun uniqueIndices key from to =
  let counts =
    V.foldl
      (\m i -> H.insertWith (\new old -> (fst old + 1, snd old)) (key i) (1, i) m)
      H.empty
      (V.range from to)
  in
  V.filter
    (\i ->
      match H.lookup (key i) counts with
      | Just (count, first) -> count == 1 and first == i
      | None -> False)
    (V.range from to)

-- The crate's `patience::diff`: Myers over the elements unique on each side,
-- then Myers between each matched pair of them.
@pub(pkg) fun patience same oldKey newKey oa ob na nb =
  let oldUnique = V.toArray (uniqueIndices oldKey oa ob) in
  let newUnique = V.toArray (uniqueIndices newKey na nb) in
  let uniqueSame = \i j -> oldKey (arrayGet oldUnique i) == newKey (arrayGet newUnique j) in
  let matched =
    V.concatMap
      (\op ->
        match op with
        | DiffOp.Equal o n l -> V.map (\k -> (o + k, n + k)) (V.range 0 l)
        | _ -> V.empty)
      (myers uniqueSame 0 (arrayLen oldUnique) 0 (arrayLen newUnique))
  in
  let step = \acc pair ->
    match acc with
    | (oc, nc, out) ->
        match pair with
        | (i, j) ->
            let ou = arrayGet oldUnique i in
            let nu = arrayGet newUnique j in
            let rec skip a b = if a < ou and b < nu and same a b then skip (a + 1) (b + 1) else (a, b) in
            match skip oc nc with
            | (a, b) ->
                let out2 = if a > oc then V.pushBack out (DiffOp.Equal oc nc (a - oc)) else out in
                (ou, nu, V.append out2 (myers same a ou b nu))
  in
  match V.foldl step (oa, na, V.empty) matched with
  | (oc, nc, out) -> V.append out (myers same oc ob nc nb)

-- --- the hooks --------------------------------------------------------------------------

-- The crate's `Replace` hook, over the operations reaching it: runs of
-- equals merged, and a delete next to an insert made one replace.
@pub(pkg) fun replaceOps ops =
  let flushEq = \st ->
    match st with
    | (del, ins, eq, out) ->
        match eq with
        | Just (o, n, l) -> (del, ins, None, V.pushBack out (DiffOp.Equal o n l))
        | None -> st
  in
  let flushDelIns = \st ->
    match st with
    | (del, ins, eq, out) ->
        match del with
        | Just (o, l, n) ->
            (match ins with
             | Just (_, n2, l2) -> (None, None, eq, V.pushBack out (DiffOp.Replace o l n2 l2))
             | None -> (None, ins, eq, V.pushBack out (DiffOp.Delete o l n)))
        | None ->
            match ins with
            | Just (o, n, l) -> (del, None, eq, V.pushBack out (DiffOp.Insert o n l))
            | None -> st
  in
  let step = \st op ->
    match op with
    | DiffOp.Equal o n l ->
        (match flushDelIns st with
         | (del, ins, eq, out) ->
             let merged =
               match eq with
               | Just (eo, en, el) -> Just (eo, en, el + l)
               | None -> Just (o, n, l)
             in
             (del, ins, merged, out))
    | DiffOp.Delete o l n ->
        (match flushEq st with
         | (del, ins, eq, out) ->
             let merged =
               match del with
               | Just (d0, dl, dn) -> Just (d0, dl + l, dn)
               | None -> Just (o, l, n)
             in
             (merged, ins, eq, out))
    | DiffOp.Insert o n l ->
        (match flushEq st with
         | (del, ins, eq, out) ->
             let merged =
               match ins with
               | Just (i0, i1, il) -> Just (i0, i1, l + il)
               | None -> Just (o, n, l)
             in
             (del, merged, eq, out))
    | DiffOp.Replace o ol n nl ->
        match flushEq st with
        | (del, ins, eq, out) -> (del, ins, eq, V.pushBack out (DiffOp.Replace o ol n nl))
  in
  match flushDelIns (flushEq (V.foldl step (None, None, None, V.empty) ops)) with
  | (_, _, _, out) -> out

fun insertAt v i x = V.append (V.pushBack (V.take v i) x) (V.drop v i)

fun removeAt v i = V.append (V.take v i) (V.drop v (i + 1))

fun swapAt v i j =
  let a = V.getOr (DiffOp.Equal 0 0 0) v i in
  let b = V.getOr (DiffOp.Equal 0 0 0) v j in
  V.set (V.set v i b) j a

fun opAt v i = V.getOr (DiffOp.Equal 0 0 0) v i

fun modifyAt v i f = V.set v i (f (opAt v i))

fun rangeLen r =
  match r with
  | (a, b) -> if b > a then b - a else 0

fun startOf r = fst r

fun endOf r = snd r

-- The common suffix of `op`'s old range and `other`'s new range.
fun suffixAcross same op other =
  match (oldRange op, newRange other) with
  | ((oa, ob), (na, nb)) -> commonSuffixLen same oa ob na nb

-- The common prefix of `op`'s old range and `other`'s new range.
fun prefixAcross same op other =
  match (oldRange op, newRange other) with
  | ((oa, ob), (na, nb)) -> commonPrefixLen same oa ob na nb

-- The crate's `shift_diff_ops_up`.
fun shiftUp same ops pointer =
  if pointer < 1 or pointer >= V.len ops
  then (ops, pointer)
  else
    let this = opAt ops pointer in
    let prev = opAt ops (pointer - 1) in
    let nextIsEqual = pointer + 1 < V.len ops and opTag (opAt ops (pointer + 1)) == DiffTag.Equal in
    let shifted = \suffixLen equalLen ->
      let po = oldRange prev in
      let tn = newRange this in
      let withEqual =
        if nextIsEqual
        then modifyAt ops (pointer + 1) (\op -> growLeft op suffixLen)
        else insertAt ops (pointer + 1) (DiffOp.Equal (endOf po - suffixLen) (endOf tn - suffixLen) equalLen)
      in
      let slid = modifyAt withEqual pointer (\op -> shiftLeft op suffixLen) in
      let moved = modifyAt slid (pointer - 1) (\op -> shrinkLeft op suffixLen) in
      if isEmptyOp (opAt moved (pointer - 1))
      then shiftUp same (removeAt moved (pointer - 1)) (pointer - 1)
      else shiftUp same moved pointer
    in
    match (opTag this, opTag prev) with
    | (DiffTag.Insert, DiffTag.Equal) ->
        let suffixLen = suffixAcross same prev this in
        if suffixLen > 0
        then shifted suffixLen suffixLen
        else if isEmptyOp prev
        then shiftUp same (removeAt ops (pointer - 1)) (pointer - 1)
        else (ops, pointer)
    | (DiffTag.Delete, DiffTag.Equal) ->
        let suffixLen = suffixAcross same prev this in
        if suffixLen != 0
        then shifted suffixLen (rangeLen (oldRange prev) - suffixLen)
        else if isEmptyOp prev
        then shiftUp same (removeAt ops (pointer - 1)) (pointer - 1)
        else (ops, pointer)
    | (DiffTag.Insert, DiffTag.Delete) -> shiftUp same (swapAt ops (pointer - 1) pointer) (pointer - 1)
    | (DiffTag.Delete, DiffTag.Insert) -> shiftUp same (swapAt ops (pointer - 1) pointer) (pointer - 1)
    | (DiffTag.Insert, DiffTag.Insert) ->
        let grown = modifyAt ops (pointer - 1) (\op -> growRight op (rangeLen (newRange this))) in
        shiftUp same (removeAt grown pointer) (pointer - 1)
    | (DiffTag.Delete, DiffTag.Delete) ->
        let grown = modifyAt ops (pointer - 1) (\op -> growRight op (rangeLen (oldRange this))) in
        shiftUp same (removeAt grown pointer) (pointer - 1)
    | _ -> (ops, pointer)

-- The crate's `shift_diff_ops_down`.
fun shiftDown same ops pointer =
  if pointer + 1 >= V.len ops
  then (ops, pointer)
  else
    let this = opAt ops pointer in
    let next = opAt ops (pointer + 1) in
    let prevIsEqual = pointer >= 1 and opTag (opAt ops (pointer - 1)) == DiffTag.Equal in
    let shifted = \prefixLen ->
      let withEqual =
        if prevIsEqual
        then (modifyAt ops (pointer - 1) (\op -> growRight op prefixLen), pointer)
        else
          let equal = DiffOp.Equal (startOf (oldRange next)) (startOf (newRange this)) prefixLen in
          (insertAt ops pointer equal, pointer + 1)
      in
      match withEqual with
      | (v, p) ->
          let slid = modifyAt v p (\op -> shiftRight op prefixLen) in
          let moved = modifyAt slid (p + 1) (\op -> shrinkRight op prefixLen) in
          if isEmptyOp (opAt moved (p + 1))
          then shiftDown same (removeAt moved (p + 1)) p
          else shiftDown same moved p
    in
    let equalCase = \prefixLen ->
      if prefixLen > 0
      then shifted prefixLen
      else if isEmptyOp next
      then shiftDown same (removeAt ops (pointer + 1)) pointer
      else (ops, pointer)
    in
    match (opTag this, opTag next) with
    | (DiffTag.Insert, DiffTag.Equal) ->
        equalCase (prefixAcross same next this)
    | (DiffTag.Delete, DiffTag.Equal) ->
        equalCase (prefixAcross same next this)
    | (DiffTag.Insert, DiffTag.Delete) -> shiftDown same (swapAt ops pointer (pointer + 1)) (pointer + 1)
    | (DiffTag.Delete, DiffTag.Insert) -> shiftDown same (swapAt ops pointer (pointer + 1)) (pointer + 1)
    | (DiffTag.Insert, DiffTag.Insert) ->
        let grown = modifyAt ops pointer (\op -> growRight op (rangeLen (newRange next))) in
        shiftDown same (removeAt grown (pointer + 1)) pointer
    | (DiffTag.Delete, DiffTag.Delete) ->
        let grown = modifyAt ops pointer (\op -> growRight op (rangeLen (oldRange next))) in
        shiftDown same (removeAt grown (pointer + 1)) pointer
    | _ -> (ops, pointer)

-- One pass of the crate's `cleanup_diff_ops`, over the operations tagged `tag`.
fun cleanupPass same tag ops =
  let rec go v pointer =
    if pointer >= V.len v
    then v
    else if opTag (opAt v pointer) == tag
    then
      match shiftUp same v pointer with
      | (v2, p2) ->
          match shiftDown same v2 p2 with
          | (v3, p3) -> go v3 (p3 + 1)
    else go v (pointer + 1)
  in
  go ops 0

-- The crate's `Compact` hook: deletions, then insertions, slid as far up and
-- down as the text allows, so that they line up with others.
@pub(pkg) fun compactOps same ops = cleanupPass same DiffTag.Insert (cleanupPass same DiffTag.Delete ops)

-- The operations `alg` finds between `oa..ob` and `na..nb`, compacted and
-- merged: the crate's `capture_diff`. `oldKey` and `newKey` give each element
-- a hashable key, which patience needs.
@pub(pkg) fun captureWith alg same oldKey newKey oa ob na nb =
  let raw =
    match alg with
    | Algorithm.Myers -> myers same oa ob na nb
    | Algorithm.Patience -> patience same oldKey newKey oa ob na nb
    | Algorithm.Lcs -> lcs same oa ob na nb
  in
  replaceOps (compactOps same raw)

-- The operations `alg` finds between `old[oa..ob]` and `new[na..nb]`.
@pub fun captureDiff alg (old : #[a]) oa ob (new : #[a]) na nb =
  let same = \i j -> arrayGet old i == arrayGet new j in
  captureWith alg same (\i -> arrayGet old i) (\j -> arrayGet new j) oa ob na nb

-- The operations `alg` finds between `old` and `new`.
@pub fun captureDiffSlices alg (old : #[a]) (new : #[a]) = captureDiff alg old 0 (arrayLen old) new 0 (arrayLen new)

-- --- after the diff ---------------------------------------------------------------------

-- How alike the two sides are, from 0 to 1: twice the elements in common,
-- over all the elements.
@pub fun getDiffRatio ops oldLen newLen =
  let matches =
    V.foldl
      (\acc op ->
        match op with
        | DiffOp.Equal _ _ l -> acc + l
        | _ -> acc)
      0
      ops
  in
  let total = oldLen + newLen in
  if total == 0
  then toFloat32 1.0
  else toFloat32 2.0 *. toFloat32 (toFloat matches) /. toFloat32 (toFloat total)

fun saturatingSub a b = if a > b then a - b else 0

-- `ops` in groups, each change with up to `n` equal elements around it: the
-- hunks of a unified diff.
@pub fun groupDiffOps ops n =
  if V.isEmpty ops
  then []
  else
    let trimFirst =
      match opAt ops 0 with
      | DiffOp.Equal o ni l ->
          let offset = saturatingSub l n in
          V.set ops 0 (DiffOp.Equal (o + offset) (ni + offset) (l - offset))
      | _ -> ops
    in
    let last = V.len trimFirst - 1 in
    let trimmed =
      match opAt trimFirst last with
      | DiffOp.Equal o ni l -> V.set trimFirst last (DiffOp.Equal o ni (l - saturatingSub l n))
      | _ -> trimFirst
    in
    let step = \acc op ->
      match acc with
      | (pending, groups) ->
          match op with
          | DiffOp.Equal o ni l ->
              if l > n * 2
              then
                let offset = saturatingSub l n in
                let closed = V.pushBack pending (DiffOp.Equal o ni n) in
                ([DiffOp.Equal (o + offset) (ni + offset) (l - offset)], V.pushBack groups closed)
              else (V.pushBack pending op, groups)
          | _ -> (V.pushBack pending op, groups)
    in
    match V.foldl step (V.empty, V.empty) trimmed with
    | (pending, groups) ->
        let onlyEqual =
          V.len pending == 1
          and (
            match opAt pending 0 with
            | DiffOp.Equal _ _ _ -> True
            | _ -> False
          )
        in
        if V.isEmpty pending or onlyEqual then groups else V.pushBack groups pending
