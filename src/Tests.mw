-- The port against the crate: every case in `Cases.mw` and `CasesPlain.mw`,
-- whose expected results came from calling similar itself, plus a few
-- examples.
--
-- Every declaration carries `@cfg(test)`, as the tests are no part of the
-- package.

@cfg(test)
use Std.Test (assertEq)
@cfg(test)
use Std.Collections.Vector as V
@cfg(test)
use Std.String as S
@cfg(test)
use Diff.Cases (cases)
@cfg(test)
use Diff.CasesPlain (casesPlain)
@cfg(test)
use Diff.Types
@cfg(test)
use Diff.Algorithms
@cfg(test)
use Diff.Text
@cfg(test)
use Diff.Unified
@cfg(test)
use Diff.Inline
@cfg(test)
use Diff.Parts

-- --- reading the cases --------------------------------------------------------------------

@cfg(test)
fun num src i n =
  let rec go k acc = if k >= n then acc else go (k + 1) (acc * 64 + (toInt (stringByteAt src (i + k)) - 48)) in
  (go 0 0, i + n)

@cfg(test)
fun str src i =
  let len = fst (num src i 3) in
  (stringSlice src (i + 3) (i + 3 + len), i + 3 + len)

-- A list of strings, and where it ends.
@cfg(test)
fun strs src i =
  let count = num src i 3 in
  let rec go k at acc =
    if k >= fst count
    then (acc, at)
    else
      match str src at with
      | (s, next) -> go (k + 1) next (V.pushBack acc s)
  in
  go 0 (snd count) V.empty

-- A non-negative decimal number, or 0.
@cfg(test)
fun decimal s =
  let rec go i acc =
    if i >= stringByteLength s
    then acc
    else
      let c = toInt (stringByteAt s i) in
      if c >= 48 and c <= 57 then go (i + 1) (acc * 10 + c - 48) else acc
  in
  go 0 0

@cfg(test)
def algorithms = [Algorithm.Myers, Algorithm.Patience, Algorithm.Lcs]

@cfg(test)
fun algorithmAt k = V.getOr Algorithm.Myers algorithms k

-- --- spelling results as the generator does -----------------------------------------------

@cfg(test)
fun opText op =
  match op with
  | DiffOp.Equal o n l -> "E ${o} ${n} ${l}"
  | DiffOp.Delete o ol n -> "D ${o} ${ol} ${n}"
  | DiffOp.Insert o n nl -> "I ${o} ${n} ${nl}"
  | DiffOp.Replace o ol n nl -> "R ${o} ${ol} ${n} ${nl}"

@cfg(test)
fun opsText ops = S.join ", " (V.map opText ops)

@cfg(test)
fun tagChar t =
  match t with
  | ChangeTag.Equal -> "="
  | ChangeTag.Delete -> "-"
  | ChangeTag.Insert -> "+"

@cfg(test)
fun indexText m =
  match m with
  | Just i -> "${i}"
  | None -> "_"

@cfg(test)
fun boolText b = if b then "true" else "false"

@cfg(test)
fun ratioText (r : Float32) = floor (toFloat64 r *. 4294967296.0)

@cfg(test)
fun digitsText (xs : #[Int]) = charsToString (V.toArray (V.map (\d -> charFromCode (48 + d)) (V.fromArray xs)))

@cfg(test)
fun partsText parts = V.map (\p -> match p with | (t, s) -> tagChar t ++ s) parts

@cfg(test)
fun orElse d m =
  match m with
  | Just x -> x
  | None -> d

-- --- the cases ----------------------------------------------------------------------------

-- Kind 0: sequences.
@cfg(test)
fun sequenceCase i =
  let alg = num cases i 1 in
  let oldText = str cases (snd alg) in
  let newText = str cases (snd oldText) in
  let digits = \s -> V.toArray (V.map (\c -> charCode c - 48) (V.fromArray (stringToChars s))) in
  let old = digits (fst oldText) in
  let new = digits (fst newText) in
  let oa = num cases (snd newText) 2 in
  let ob = num cases (snd oa) 2 in
  let na = num cases (snd ob) 2 in
  let nb = num cases (snd na) 2 in
  let n = num cases (snd nb) 1 in
  let expected = strs cases (snd n) in
  let a = algorithmAt (fst alg) in
  let ops = captureDiff a old (fst oa) (fst ob) new (fst na) (fst nb) in
  let groups = V.map (\g -> "group: " ++ opsText g) (groupDiffOps ops (fst n)) in
  let whole = fst oa == 0 and fst ob == arrayLen old and fst na == 0 and fst nb == arrayLen new in
  let slices =
    if whole
    then V.map (\p -> match p with | (t, xs) -> "slice ${tagChar t} ${digitsText xs}") (diffSliceParts a old new)
    else []
  in
  let got = V.append (V.append (V.map opText ops) groups) slices in
  ("${fst oldText} ${fst newText}", fst expected, got, snd expected)

@cfg(test)
fun configOf alg nl =
  let terminated = if nl == 1 then Just False else if nl == 2 then Just True else None in
  { textDiffConfig | algorithm = algorithmAt alg, newlineTerminated = terminated }

@cfg(test)
fun tokenized kind config old new =
  if kind == 0
  then diffLines config old new
  else if kind == 1
  then diffWords config old new
  else if kind == 2
  then diffChars config old new
  else if kind == 3
  then diffUnicodeWords config old new
  else diffGraphemes config old new

@cfg(test)
fun inlineText inline (d : TextDiff) =
  V.concatMap
    (\op ->
      V.map
        (\(c : InlineChange) ->
          let values = S.join "|" (V.map (\p -> match p with | (e, s) -> (if e then "*" else ".") ++ s) c.values) in
          let place = "${tagChar c.tag} ${indexText c.oldIndex} ${indexText c.newIndex}" in
          "inline ${place} [${values}] ${inlineChangeText c}")
        (inline d op))
    d.ops

-- Kind 1: text diffs.
@cfg(test)
fun textCase i =
  let kind = num cases i 1 in
  let alg = num cases (snd kind) 1 in
  let nl = num cases (snd alg) 1 in
  let old = str cases (snd nl) in
  let new = str cases (snd old) in
  let expected = strs cases (snd new) in
  let want = fst expected in
  let d = tokenized (fst kind) (configOf (fst alg) (fst nl)) (fst old) (fst new) in
  let terminated = boolText d.newlineTerminated in
  let slices = "${arrayLen d.old} ${arrayLen d.new}" in
  let head = "ops ${opsText d.ops} ratio ${ratioText (ratio d)} slices ${slices} nl ${terminated}" in
  let changes =
    V.map
      (\(c : Change String) -> "${tagChar c.tag} ${indexText c.oldIndex} ${indexText c.newIndex} ${c.value}")
      (iterAllChanges d)
  in
  -- The context sizes were the generator's to pick: read them back.
  let n = decimal (S.drop (orElse "" (V.find (S.startsWith "group ") want)) 6) in
  let groups = V.map (\g -> "group ${n}: ${opsText g}") (groupedOps d n) in
  let settings =
    match V.find (S.startsWith "unified ") want with
    | Just line -> S.split " " (S.take line (orElse 0 (S.indexOf "\n" line)))
    | None -> []
  in
  let radius = decimal (V.getOr "0" settings 1) in
  let hint = V.getOr "" settings 2 == "true" in
  let header = V.getOr "" settings 3 == "true" in
  let names = if header then Just ("a/old.txt", "b/new.txt") else None in
  let u = { unifiedDiff d | contextRadius = radius, missingNewlineHint = hint, header = names } in
  let unified = "unified ${radius} ${boolText hint} ${boolText header}\n${unifiedDiffText u}" in
  let before = V.append (V.pushFront changes head) groups in
  let got = V.append (V.pushBack before unified) (inlineText iterInlineChanges d) in
  ("${fst old} => ${fst new}", want, got, snd expected)

-- Kind 2: close matches.
@cfg(test)
fun closeMatchCase i =
  let word = str cases i in
  let possibilities = strs cases (snd word) in
  let n = num cases (snd possibilities) 1 in
  let cutoff = num cases (snd n) 2 in
  let expected = strs cases (snd cutoff) in
  let c = toFloat32 (toFloat (fst cutoff) /. 10.0) in
  let got = getCloseMatches (fst word) (fst possibilities) (fst n) c in
  (fst word, fst expected, got, snd expected)

-- Kinds 3 and 4: the `utils` helpers.
@cfg(test)
fun partsCase kind i =
  let helper = num cases i 1 in
  let alg = num cases (snd helper) 1 in
  let old = str cases (snd alg) in
  let new = str cases (snd old) in
  let expected = strs cases (snd new) in
  let a = algorithmAt (fst alg) in
  let h = fst helper in
  let parts =
    if kind == 3 and h == 0
    then diffCharParts a (fst old) (fst new)
    else if kind == 3 and h == 1
    then diffWordParts a (fst old) (fst new)
    else if kind == 3
    then diffLineParts a (fst old) (fst new)
    else if h == 0
    then diffUnicodeWordParts a (fst old) (fst new)
    else diffGraphemeParts a (fst old) (fst new)
  in
  ("${fst old} => ${fst new}", fst expected, partsText parts, snd expected)

-- Kind 5: inline changes by plain words.
@cfg(test)
fun plainCase i =
  let kind = num casesPlain i 1 in
  let alg = num casesPlain (snd kind) 1 in
  let nl = num casesPlain (snd alg) 1 in
  let old = str casesPlain (snd nl) in
  let new = str casesPlain (snd old) in
  let expected = strs casesPlain (snd new) in
  let d = tokenized (fst kind) (configOf (fst alg) (fst nl)) (fst old) (fst new) in
  ("${fst old} => ${fst new}", fst expected, inlineText iterInlineChangesByWords d, snd expected)

@cfg(test)
fun runCase src i =
  let kind = fst (num src i 1) in
  if kind == 0
  then sequenceCase (i + 1)
  else if kind == 1
  then textCase (i + 1)
  else if kind == 2
  then closeMatchCase (i + 1)
  else if kind == 5
  then plainCase (i + 1)
  else partsCase kind (i + 1)

-- The first line where `want` and `got` differ.
@cfg(test)
fun firstDifference want got =
  let n = if V.len want > V.len got then V.len want else V.len got in
  match V.find (\k -> V.get want k != V.get got k) (V.range 0 n) with
  | Just k -> (V.getOr "<none>" want k, V.getOr "<none>" got k)
  | None -> ("", "")

@cfg(test)
fun check src i bad =
  if i >= stringByteLength src
  then bad
  else
    match runCase src i with
    | (input, want, got, next) ->
        check src next (if want == got then bad else V.pushBack bad (input, firstDifference want got))

-- Failures list (input, (expected, actual)).
@cfg(test)
@test fun resultsMatchTheCrate () =
  assertEq (V.take (check cases 0 V.empty) 3) [] "cases where the port and similar differ"

@cfg(test)
@test fun plainWordsMatchTheCrate () =
  assertEq (V.take (check casesPlain 0 V.empty) 3) [] "inline changes where the port and similar differ"

@cfg(test)
@test fun examples () =
  let u = unifiedDiffText (unifiedDiff (fromLines "a\nb\nc\n" "a\nB\nc\n")) in
  let a = assertEq u "@@ -1,3 +1,3 @@\n a\n-b\n+B\n c\n" "unified" in
  let ops = captureDiffSlices Algorithm.Myers #[1, 2, 3] #[1, 3] in
  let b = assertEq ops [DiffOp.Equal 0 0 1, DiffOp.Delete 1 1 1, DiffOp.Equal 2 1 1] "ops" in
  let close = getCloseMatches "appel" ["ape", "apple", "peach", "puppy"] 3 (toFloat32 0.6) in
  let c = assertEq close ["apple", "ape"] "close" in
  assertEq (partsText (diffWordParts Algorithm.Myers "one two" "one three")) ["=one ", "-two", "+three"] "word parts"
